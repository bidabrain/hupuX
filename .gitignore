# ── 编译输出 ──────────────────────────────────────────────
build/
app/build/
**/build/

# ── Gradle / Kotlin 缓存 ──────────────────────────────────
.gradle/
.kotlin/

# ── Xcode（iOS）────────────────────────────────────────────
xcuserdata/
*.xcuserstate
ios/**/build/
DerivedData/

# ── 本地配置（含 SDK 路径，每台机器不同）────────────────────
local.properties

# ── IDE 文件（Android Studio / IntelliJ）────────────────────
.idea/
*.iml
*.ipr
*.iws

# ── macOS 系统文件 ────────────────────────────────────────
.DS_Store

# ── 签名 keystore（包含私钥，绝对不能上传）────────────────
*.jks
*.keystore
# 例外：app/release.keystore 是本 app 专用的自签名 key，
# 提交进仓库是为了让 CI 每次用同一把 key 签名，用户可直接覆盖升级。
!app/release.keystore

# ── 性能分析 / 截图抓取 ───────────────────────────────────
captures/
profiling/
